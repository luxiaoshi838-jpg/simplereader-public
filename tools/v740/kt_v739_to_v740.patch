+    private static int safePrefInt(SharedPreferences sp, String key, int fallback) {
+        try { return sp.getInt(key, fallback); } catch (Throwable ignored) {}
+        try { return Integer.parseInt(sp.getString(key, String.valueOf(fallback)).trim()); } catch (Throwable ignored) {}
+        try { return (int) sp.getLong(key, fallback); } catch (Throwable ignored) {}
+        return fallback;
+    }
+
+    private static String safePrefString(SharedPreferences sp, String key, String fallback) {
+        try {
+            String value = sp.getString(key, fallback);
+            return value == null ? fallback : value;
+        } catch (Throwable ignored) {}
+        try { return String.valueOf(sp.getInt(key, 0)); } catch (Throwable ignored) {}
+        try { return String.valueOf(sp.getLong(key, 0L)); } catch (Throwable ignored) {}
+        return fallback;
+    }
+
+    private static String rootMessage(Throwable error) {
+        Throwable root = error;
+        try {
+            while (root instanceof java.lang.reflect.InvocationTargetException &&
+                    ((java.lang.reflect.InvocationTargetException) root).getTargetException() != null) {
+                root = ((java.lang.reflect.InvocationTargetException) root).getTargetException();
+            }
+        } catch (Throwable ignored) {}
+        if (root == null) return "未知异常";
+        String message = root.getMessage();
+        return root.getClass().getName() + (message == null || message.length() == 0 ? "" : ": " + message);
+    }
