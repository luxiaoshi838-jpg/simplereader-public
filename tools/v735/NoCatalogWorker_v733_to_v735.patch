+    private static Long jsonNullableLong(String json, String key) {
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile(
+                "\\\"" + java.util.regex.Pattern.quote(key) + "\\\"\\s*:\\s*(-?\\d+|null)").matcher(json);
+        if (!m.find() || "null".equals(m.group(1))) return null;
+        try { return Long.valueOf(Long.parseLong(m.group(1))); } catch (Throwable ignored) { return null; }
+    }
+
+    private static long jsonLong(String json, String key, long def) {
+        Long v = jsonNullableLong(json, key); return v == null ? def : v.longValue();
+    }
+
+    private static boolean jsonBool(String json, String key, boolean def) {
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile(
+                "\\\"" + java.util.regex.Pattern.quote(key) + "\\\"\\s*:\\s*(true|false)").matcher(json);
+        return m.find() ? "true".equals(m.group(1)) : def;
+    }
+
+    private static String jsonString(String json, String key) {
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile(
+                "\\\"" + java.util.regex.Pattern.quote(key) + "\\\"\\s*:\\s*\\\"((?:\\\\.|[^\\\"\\\\])*)\\\"").matcher(json);
+        if (!m.find()) return null;
+        return m.group(1).replace("\\\\\\\"", "\\\"").replace("\\\\\\\\", "\\\\");
+    }
