+    private static boolean hasCompletedReusableCache(Context context, Object book) {
+        if (context == null || book == null) return false;
+        try {
+            Class<?> bc = book.getClass();
+            long id = ((Number)bc.getMethod("getId").invoke(book)).longValue();
+
+            Object fnObj = bc.getMethod("getFileName").invoke(book);
+            String fileName = fnObj == null ? "" : String.valueOf(fnObj).trim();
+            if (fileName.isEmpty()) return false;
+
+            Object fsObj = bc.getMethod("getFileSize").invoke(book);
+            if (!(fsObj instanceof Number)) return false;
+            long fileSize = ((Number)fsObj).longValue();
+            if (fileSize < 0L) return false;
+
+            Object fpObj = bc.getMethod("getFilePath").invoke(book);
+            String filePath = fpObj == null ? "" : String.valueOf(fpObj);
+            if (filePath.trim().isEmpty()) return false;
+
+            File filesDir = (File)context.getClass().getMethod("getFilesDir").invoke(context);
+            File dir = new File(new File(filesDir, "reader_page_cache"), String.valueOf(id));
+            File recognition = new File(dir, "recognition.json");
+            if (!recognition.isFile()) return false;
+            String rec = readUtf8(recognition);
+
+            if (!jsonBool(rec, "completed", false)) return false;
+            if (jsonLong(rec, "chapterCount", 0L) <= 0L) return false;
+
+            String storedName = jsonString(rec, "fileName");
+            if (storedName == null || !storedName.equalsIgnoreCase(fileName)) return false;
+            Long storedSize = jsonNullableLong(rec, "fileSize");
+            if (storedSize == null || storedSize.longValue() != fileSize) return false;
+
+            File[] files = dir.listFiles();
+            if (files == null) return false;
+            for (File f : files) {
+                if (f == null || !f.isFile()) continue;
+                String n = f.getName();
+                if (!("pages.json".equals(n) || (n.startsWith("pages-") && n.endsWith(".json")))) continue;
+                try {
+                    String m = readUtf8(f);
+                    if (jsonLong(m, "bookId", -1L) != id) continue;
+                    String storedPath = jsonString(m, "filePath");
+                    if (storedPath == null || !storedPath.equals(filePath)) continue;
+                    Long manifestSize = jsonNullableLong(m, "fileSize");
+                    if (manifestSize == null || manifestSize.longValue() != fileSize) continue;
+                    if (!jsonArrayNonEmpty(m, "pages")) continue;
+                    return true;
+                } catch (Throwable ignored) {}
+            }
+            return false;
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
