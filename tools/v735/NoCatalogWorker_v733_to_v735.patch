+    private static boolean jsonArrayNonEmpty(String json, String key) {
+        java.util.regex.Matcher m = java.util.regex.Pattern.compile(
+                "\\\"" + java.util.regex.Pattern.quote(key) + "\\\"\\s*:\\s*\\[").matcher(json);
+        if (!m.find()) return false;
+        for (int i=m.end(); i<json.length(); i++) {
+            char c=json.charAt(i); if (Character.isWhitespace(c)) continue; return c != ']';
+        }
+        return false;
+    }
