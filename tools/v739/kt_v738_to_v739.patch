+    private static void saveLogUiError(Context context, Throwable error) {
+        Context a = app(context);
+        if (a == null) return;
+        Throwable root = error;
+        try {
+            while (root instanceof java.lang.reflect.InvocationTargetException &&
+                    ((java.lang.reflect.InvocationTargetException) root).getTargetException() != null) {
+                root = ((java.lang.reflect.InvocationTargetException) root).getTargetException();
+            }
+        } catch (Throwable ignored) {}
+        String message = root == null ? "未知异常" : root.toString();
+        try {
+            a.getSharedPreferences(PREF, Context.MODE_PRIVATE).edit()
+                    .putString("operation_log_ui_error", message)
+                    .putLong("operation_log_ui_error_at", System.currentTimeMillis())
+                    .apply();
+        } catch (Throwable ignored) {}
